rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlayerInMatch(matchData) {
      return isAuthenticated() && (
        matchData.get('tigerPlayerId', null) == request.auth.uid ||
        matchData.get('goatPlayerId', null) == request.auth.uid
      );
    }

    function isClaimingSlot(prevData, nextData) {
      return isAuthenticated() && prevData.get('status', '') == 'waiting' && (
        (prevData.get('tigerPlayerId', null) == null && nextData.get('tigerPlayerId', null) == request.auth.uid) ||
        (prevData.get('goatPlayerId', null) == null && nextData.get('goatPlayerId', null) == request.auth.uid)
      );
    }

    // Users collection.
    // Any signed-in user can read profiles (needed for the leaderboard);
    // a user may only create/update their own, and cannot self-edit ratings.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['stats.overallRating', 'stats.tigerRating', 'stats.goatRating']));
      allow delete: if false;

      // Friends subcollection
      match /friends/{friendId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Matches collection
    match /matches/{matchId} {
      // Anyone authenticated can read matches (matchmaking + spectating).
      allow read: if isAuthenticated();

      // The creator must place their own uid in one of the two slots.
      allow create: if isAuthenticated()
        && (request.resource.data.get('tigerPlayerId', null) == request.auth.uid
            || request.resource.data.get('goatPlayerId', null) == request.auth.uid);

      // Updates are allowed for:
      //  (a) an existing participant — sending moves, offering/answering a draw, completing/cancelling
      //  (b) a second player claiming an open slot on a waiting match
      allow update: if isPlayerInMatch(resource.data) || isClaimingSlot(resource.data, request.resource.data);

      // No delete - matches are historical records
      allow delete: if false;
    }

    // Game moves subcollection (reserved)
    match /matches/{matchId}/moves/{moveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && isPlayerInMatch(get(/databases/$(database)/documents/matches/$(matchId)).data);
    }

    // Match messages subcollection
    match /matches/{matchId}/messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && isPlayerInMatch(get(/databases/$(database)/documents/matches/$(matchId)).data);
    }

    // Presence (online player count)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Leaderboard (read-only aggregate)
    match /leaderboard/{entry} {
      allow read: if isAuthenticated();
      allow write: if false; // Only cloud functions can update
    }

    // Game statistics (global stats)
    match /statistics/{stat} {
      allow read: if true; // Public stats
      allow write: if false; // Only cloud functions
    }
  }
}
